# Take it back: every setting the app reads. Values here are placeholders, never real secrets.
# Where: V = Vercel project env (Production + Preview), S = Supabase function secrets, G = GitHub repo secret/variable.
# Required settings are marked (required); everything else switches a feature on when present.

# ---- Core (V) ----
NEXT_PUBLIC_SUPABASE_URL=https://uzogyqreputvggefnxiy.supabase.co   # (required) Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=                                       # (required) Supabase publishable key, safe in the browser
NEXT_PUBLIC_SITE_URL=https://www.takeitback.app                      # (required) used in emails and auth links
BILLING_SECRET=                                                      # (required) shared secret for billing/case-pass/send database functions (its SHA-256 is in private.config)

# ---- Document reading and letters (V) ----
ANTHROPIC_API_KEY=            # turns on AI reading of documents, letters and replies
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_PRICE_IN=2                 # dollars per million input tokens, for the admin cost estimate only
AI_PRICE_OUT=10               # dollars per million output tokens

# ---- Web payments: Stripe (V) ----
STRIPE_SECRET_KEY=            # Premium on the website, case pass, mail and fax
STRIPE_WEBHOOK_SECRET=        # webhook /api/stripe/webhook. Events: checkout.session.completed, customer.subscription.*,
                              # invoice.upcoming, invoice.payment_failed, customer.subscription.trial_will_end, charge.refunded

# ---- Email: Resend (V) ----
RESEND_API_KEY=
EMAIL_FROM=Take it back <hello@takeitback.app>

# ---- Texts: Twilio (S, daily-reminders function) ----
# TWILIO_ACCOUNT_SID=  TWILIO_AUTH_TOKEN=  TWILIO_FROM=

# ---- Mail and fax sent for you (V) ----
LOB_API_KEY=
TELNYX_API_KEY=
TELNYX_FAX_CONNECTION_ID=
TELNYX_FAX_FROM=

# ---- Forwarded bills by email: Postmark inbound (V) ----
# Point the inbound webhook at https://hello:INBOUND_SECRET@www.takeitback.app/api/inbound/email (Basic auth)
INBOUND_SECRET=
INBOUND_DOMAIN=in.takeitback.app
SUPABASE_SERVICE_ROLE_KEY=    # only used by forwarded bills (no signed-in user). Never expose to the browser.

# ---- Browser push alerts (V) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=  # npx web-push generate-vapid-keys; same value as VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@takeitback.app

# ---- Analytics (V) ----
NEXT_PUBLIC_GA_ID=G-BJDG7ZD8E8  # public marketing pages only

# ---- iPhone app (V) ----
APPLE_TEAM_ID=                # turns on universal links (apple-app-site-association)
APPLE_APP_ID=                 # numeric App Store app id; enables Production receipt checks (Sandbox works without it)
APPLE_BUNDLE_ID=app.takeitback
APNS_KEY_ID=                  # Apple push key (.p8) for phone alerts in the app
APNS_TEAM_ID=
APNS_PRIVATE_KEY=             # contents of the .p8 file
APNS_TOPIC=                   # defaults to APPLE_BUNDLE_ID
APNS_SANDBOX=                 # "1" only for Xcode debug builds
APPLE_SIGNIN_KEY_ID=          # key with Sign in with Apple ticked (can be the push key); used to revoke Apple access on account deletion
APPLE_SIGNIN_PRIVATE_KEY=     # defaults to APNS_PRIVATE_KEY
NEXT_PUBLIC_APPLE_BUNDLE_ID=app.takeitback
NEXT_PUBLIC_APPLE_PRODUCT_MONTHLY=app.takeitback.premium.monthly
NEXT_PUBLIC_APPLE_PRODUCT_YEARLY=app.takeitback.premium.yearly
NEXT_PUBLIC_APPLE_PRODUCT_CASE_PASS=app.takeitback.casepass

# ---- Google sign-in (V; iOS client id also as G variable for the iPhone build) ----
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ---- Scripts and CI only (G / your shell) ----
# SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF   scripts/apple-auth-secret.mjs
# APPLE_SIGNIN_P8, APPLE_SERVICES_ID            .github/workflows/apple-auth-secret.yml
# ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8          .github/workflows/ios.yml
# SMOKE_URL                                     scripts/smoke.mjs
