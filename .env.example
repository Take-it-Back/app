# Supabase (public — safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://uzogyqreputvggefnxiy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Anthropic — server only. Reads scanned documents and writes letters.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Public site URL (used for auth email links)
NEXT_PUBLIC_SITE_URL=https://www.takeitback.app

# Billing (Stripe) — server only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_SECRET=

# Supabase service role — server only. Needed for forwarded emails (no signed-in user).
SUPABASE_SERVICE_ROLE_KEY=

# Forward bills by email (Postmark inbound webhook -> /api/inbound/email?key=INBOUND_SECRET)
INBOUND_SECRET=
INBOUND_DOMAIN=in.takeitback.app

# We mail it for you: certified mail through Lob
LOB_API_KEY=

# We fax it for you: Telnyx Programmable Fax
TELNYX_API_KEY=
TELNYX_FAX_CONNECTION_ID=
TELNYX_FAX_FROM=

# Text reminders are sent by the Supabase "daily-reminders" function.
# Set these as Supabase function secrets (not in Vercel): TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM, RESEND_API_KEY
